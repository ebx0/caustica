# Local calibration / caches
.caustica/

# Dev-validation runner output (scripts/dev_validate.py) — evidence worth keeping
# gets curated into benchmarks/reports/ by hand, never committed wholesale
dev_validate_reports/

# The master test script and its output: a LOCAL development gate, uploaded to
# a GPU runtime by hand and never shipped. It is allowed to know things about
# the project (milestone ids, evidence paths) that the library must not depend
# on, which is exactly why it stays out of the distribution.
master_test.py
master_test_reports/

# App run outputs (figures + npz + reports are regenerated, never committed)
apps/outputs/

# Source notebook stays in Drive/Colab, not in git (11 MB)
hifu_pred_dx300_t128.ipynb

# The local phantom-data root (CAUSTICA_PHANTOM_DATA points here): raw UWCEM
# downloads, caches, exports, the generated dataset and the stored setups.
# All of it moved OUT of this repository's git at M10k — the tooling lives in
# the uwcem-phantom repo, the bytes stay local.
data/
runs/

# Generated at build time by build_stamp.py (fix A1) — never committed.
src/caustica/_build_info.py

# The attic. Everything the project accumulated that the library, its tests, its
# packaging and its documentation site do not need in order to work: the Turkish
# ledgers (MILESTONES.md, PLAN.md, docs/devlog.md, docs/library_first_plan.md),
# the landscape notes, the local-only issue and janitor folders, and the
# superseded evidence runs. Kept on disk because the history in them is real,
# out of git because a live library repository is not a filing cabinet.
archive/
